{
  "$id": "https://kento08-coder.github.io/KEIBA/schemas/result.schema.json",
  "title": "KEIBA Result Import Document v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "race_id": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}-[A-Z0-9_]+-\\d{2}-[A-Z0-9_]+$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "source_agent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "sources": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "checked_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "url",
          "title",
          "checked_at"
        ],
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "document_type": {
      "type": "string",
      "const": "result"
    },
    "result_status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed",
        "corrected"
      ]
    },
    "finishers": {
      "minItems": 1,
      "maxItems": 99,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "horse_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 99
          },
          "frame_number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "rank": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 99
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "finished",
              "scratched",
              "excluded",
              "disqualified",
              "did_not_finish"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "horse_number",
          "frame_number",
          "rank",
          "status"
        ],
        "additionalProperties": false
      }
    },
    "payouts": {
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bet_type": {
            "type": "string",
            "enum": [
              "win",
              "place",
              "bracket_quinella",
              "quinella",
              "wide",
              "exacta",
              "trio",
              "trifecta"
            ]
          },
          "horse_numbers": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 99
            }
          },
          "payout_type": {
            "type": "string",
            "enum": [
              "payout",
              "refund"
            ]
          },
          "payout_per_100_yen": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "official_confirmed": {
            "type": "boolean"
          },
          "source_refs": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        },
        "required": [
          "bet_type",
          "horse_numbers",
          "payout_type",
          "payout_per_100_yen",
          "official_confirmed"
        ],
        "additionalProperties": false
      }
    },
    "observed_pace": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "slow",
            "middle",
            "high",
            "unknown",
            "other"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "verified": {
          "type": "boolean"
        },
        "passing_orders": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "checkpoint": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "horse_numbers": {
                "minItems": 1,
                "maxItems": 99,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 99
                }
              }
            },
            "required": [
              "checkpoint",
              "horse_numbers"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "label",
        "basis",
        "verified",
        "passing_orders"
      ],
      "additionalProperties": false
    },
    "interpretation": {
      "type": "object",
      "properties": {
        "race_shape": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low",
            "unknown"
          ]
        }
      },
      "required": [
        "race_shape",
        "confidence"
      ],
      "additionalProperties": false
    },
    "correction_of": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "change_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  },
  "required": [
    "schema_version",
    "race_id",
    "generated_at",
    "source_agent",
    "sources",
    "document_type",
    "result_status",
    "finishers",
    "payouts",
    "observed_pace",
    "interpretation"
  ],
  "additionalProperties": false
}
