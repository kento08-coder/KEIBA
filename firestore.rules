rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isFinalPredictionVersion(userId, raceId, versionId) {
      return exists(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/predictionVersions/$(versionId))
        && get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/predictionVersions/$(versionId)).data.status == 'final';
    }

    function raceActivePurchaseIds(data) {
      return 'activePurchaseIds' in data ? data.activePurchaseIds : [];
    }

    function racePurchaseRevision(data) {
      return 'purchaseRevision' in data ? data.purchaseRevision : 0;
    }

    function activatesNewPurchase(userId, raceId, purchaseId) {
      let before = get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(userId)/races/$(raceId)).data;
      let beforeIds = raceActivePurchaseIds(before);
      let afterIds = raceActivePurchaseIds(after);
      return beforeIds is list
        && afterIds is list
        && beforeIds.size() < 500
        && afterIds.size() == beforeIds.size() + 1
        && afterIds.toSet().size() == afterIds.size()
        && !beforeIds.toSet().hasAny([purchaseId])
        && afterIds.toSet() == beforeIds.toSet().union([purchaseId].toSet())
        && racePurchaseRevision(after) == racePurchaseRevision(before) + 1;
    }

    function advancesPurchaseCorrection(userId, raceId, oldId, newId) {
      let before = get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)).data;
      let after = getAfter(/databases/$(database)/documents/users/$(userId)/races/$(raceId)).data;
      let beforeIds = raceActivePurchaseIds(before);
      let afterIds = raceActivePurchaseIds(after);
      return beforeIds is list
        && afterIds is list
        && beforeIds.toSet().hasAny([oldId])
        && !beforeIds.toSet().hasAny([newId])
        && afterIds.size() == beforeIds.size()
        && afterIds.toSet().size() == afterIds.size()
        && afterIds.toSet() == beforeIds.toSet().difference([oldId].toSet()).union([newId].toSet())
        && racePurchaseRevision(after) == racePurchaseRevision(before) + 1;
    }

    function resultUsesCurrentPurchases(userId, raceId, data) {
      let race = get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)).data;
      return data.purchaseRevision == racePurchaseRevision(race)
        && data.activePurchaseIds == raceActivePurchaseIds(race);
    }

    function purchaseSourceExists(userId, raceId, data) {
      return (data.sourcePlanId == null
          || (exists(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/plans/$(data.sourcePlanId))
            && data.sourcePredictionVersionId == get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/plans/$(data.sourcePlanId)).data.sourcePredictionVersionId))
        && (data.sourcePredictionVersionId == null
          || isFinalPredictionVersion(userId, raceId, data.sourcePredictionVersionId));
    }

    function hasValidPurchaseShape(data, purchaseId, userId, raceId) {
      return data.keys().hasOnly([
          'authorUid', 'confirmedAt', 'correctionOf', 'correctionSequence',
          'createdAt', 'idempotencyKey', 'items', 'memo', 'placedAt',
          'purchaseId', 'raceId', 'recordedAt', 'revision', 'rootPurchaseId',
          'sourcePlanId', 'sourcePredictionVersionId', 'status',
          'totalStakeYen', 'updatedAt'
        ])
        && data.authorUid == userId
        && data.purchaseId == purchaseId
        && data.purchaseId.matches('^[A-Za-z0-9_-]{8,120}$')
        && data.raceId == raceId
        && data.rootPurchaseId is string
        && data.rootPurchaseId.matches('^[A-Za-z0-9_-]{8,120}$')
        && data.idempotencyKey is string
        && data.idempotencyKey.size() >= 8
        && data.idempotencyKey.size() <= 160
        && data.items is list
        && data.items.size() >= 1
        && data.items.size() <= 100
        && data.memo is string
        && data.memo.size() <= 2000
        && data.placedAt is string
        && data.placedAt.size() <= 80
        && data.revision is int
        && data.revision >= 1
        && data.correctionSequence is int
        && data.correctionSequence >= 0
        && data.totalStakeYen is int
        && data.totalStakeYen >= 100
        && data.totalStakeYen <= 10000000
        && data.totalStakeYen % 100 == 0
        && data.status in ['draft', 'confirmed', 'corrected']
        && data.createdAt is timestamp
        && data.recordedAt is timestamp
        && data.updatedAt is timestamp
        && ((data.status == 'draft' && data.confirmedAt == null)
          || (data.status in ['confirmed', 'corrected'] && data.confirmedAt is timestamp))
        && purchaseSourceExists(userId, raceId, data);
    }

    function isValidPurchaseCorrection(userId, raceId, data) {
      return data.status == 'corrected'
        && data.correctionOf is string
        && exists(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/purchases/$(data.correctionOf))
        && get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/purchases/$(data.correctionOf)).data.status in ['confirmed', 'corrected']
        && data.rootPurchaseId == get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/purchases/$(data.correctionOf)).data.rootPurchaseId
        && data.correctionSequence == get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/purchases/$(data.correctionOf)).data.correctionSequence + 1
        && advancesPurchaseCorrection(userId, raceId, data.correctionOf, data.purchaseId);
    }

    function hasValidResultShape(data, resultId, userId, raceId) {
      return data.keys().hasOnly([
          'authorUid', 'confirmedAt', 'contentHash', 'correctionOf',
          'correctionSequence', 'createdAt', 'idempotencyKey', 'importId',
          'payload', 'purchaseRevision', 'raceId', 'resultId', 'rootResultId',
          'status', 'updatedAt', 'activePurchaseIds'
        ])
        && data.authorUid == userId
        && data.resultId == resultId
        && data.resultId.matches('^[A-Za-z0-9_-]{8,120}$')
        && data.raceId == raceId
        && data.rootResultId is string
        && data.rootResultId.matches('^[A-Za-z0-9_-]{8,120}$')
        && data.contentHash is string
        && data.contentHash.size() == 64
        && data.importId is string
        && data.idempotencyKey is string
        && data.payload is map
        && data.payload.race_id == raceId
        && data.payload.payouts is list
        && data.payload.payouts.size() <= 1000
        && data.payload.finishers is list
        && data.payload.finishers.size() >= 1
        && data.payload.finishers.size() <= 99
        && data.activePurchaseIds is list
        && data.activePurchaseIds.size() <= 500
        && data.activePurchaseIds.toSet().size() == data.activePurchaseIds.size()
        && data.purchaseRevision is int
        && data.purchaseRevision >= 0
        && data.correctionSequence is int
        && data.correctionSequence >= 0
        && data.status in ['draft', 'confirmed', 'corrected']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && ((data.status == 'draft' && data.confirmedAt == null)
          || (data.status in ['confirmed', 'corrected'] && data.confirmedAt is timestamp));
    }

    function isValidResultCorrection(userId, raceId, data) {
      return data.status == 'corrected'
        && data.correctionOf is string
        && exists(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/results/$(data.correctionOf))
        && get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/results/$(data.correctionOf)).data.status in ['confirmed', 'corrected']
        && data.rootResultId == get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/results/$(data.correctionOf)).data.rootResultId
        && data.correctionSequence == get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)/results/$(data.correctionOf)).data.correctionSequence + 1
        && get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)).data.latestResultId == data.correctionOf
        && getAfter(/databases/$(database)/documents/users/$(userId)/races/$(raceId)).data.latestResultId == data.resultId;
    }

    function hasValidBankrollTransaction(data, transactionId, userId) {
      return data.keys().hasOnly([
          'amountYen', 'at', 'authorUid', 'idempotencyKey', 'kind', 'note',
          'raceId', 'referenceId', 'transactionId'
        ])
        && data.transactionId == transactionId
        && data.authorUid == userId
        && data.amountYen is int
        && data.amountYen >= -100000000
        && data.amountYen <= 100000000
        && data.at is timestamp
        && data.kind in ['stake', 'payout', 'adjustment']
        && data.idempotencyKey is string
        && data.idempotencyKey.size() >= 8
        && data.note is string
        && data.note.size() <= 500
        && data.raceId is string
        && data.referenceId is string;
    }

    function hasValidPlanSettings(data) {
      return data.settings is map
        && data.settings.keys().hasOnly([
          'betTypeMode',
          'budgetYen',
          'kellyFraction',
          'lossControlBudgetFraction',
          'maxSelections',
          'maxStakePerBetYen',
          'selectedBetTypes'
        ])
        && data.settings.betTypeMode in ['auto', 'manual']
        && data.settings.budgetYen is int
        && data.settings.budgetYen == data.budgetYen
        && data.settings.kellyFraction is number
        && data.settings.kellyFraction > 0
        && data.settings.kellyFraction <= 1
        && data.settings.lossControlBudgetFraction is number
        && data.settings.lossControlBudgetFraction > 0
        && data.settings.lossControlBudgetFraction <= 1
        && data.settings.maxSelections is int
        && data.settings.maxSelections >= 1
        && data.settings.maxSelections <= 50
        && data.settings.maxSelections >= data.allocations.size()
        && data.settings.maxStakePerBetYen is int
        && data.settings.maxStakePerBetYen >= 100
        && data.settings.maxStakePerBetYen <= 10000000
        && data.settings.maxStakePerBetYen % 100 == 0
        && data.settings.selectedBetTypes is list
        && data.settings.selectedBetTypes.size() <= 8
        && data.settings.selectedBetTypes.toSet().size() == data.settings.selectedBetTypes.size()
        && data.settings.selectedBetTypes.toSet().hasOnly([
          'win',
          'place',
          'bracket_quinella',
          'quinella',
          'wide',
          'exacta',
          'trio',
          'trifecta'
        ]);
    }

    function hasValidPlanSummary(data) {
      return data.summary is map
        && data.summary.keys().hasOnly([
          'expectedNetProfitYen',
          'expectedPayoutYen',
          'expectedReturnRatePercent',
          'totalStakeYen',
          'unusedBudgetYen',
          'worstCaseLossYen'
        ])
        && data.summary.expectedNetProfitYen is number
        && data.summary.expectedPayoutYen is number
        && data.summary.expectedPayoutYen >= 0
        && data.summary.totalStakeYen is int
        && data.summary.totalStakeYen >= 0
        && data.summary.totalStakeYen <= data.budgetYen
        && data.summary.totalStakeYen % 100 == 0
        && data.summary.expectedNetProfitYen >= -data.summary.totalStakeYen
        && data.summary.unusedBudgetYen is int
        && data.summary.unusedBudgetYen == data.budgetYen - data.summary.totalStakeYen
        && data.summary.worstCaseLossYen is int
        && data.summary.worstCaseLossYen == data.summary.totalStakeYen
        && (
          (data.summary.totalStakeYen == 0 && data.summary.expectedReturnRatePercent == null)
          || (
            data.summary.totalStakeYen > 0
            && data.summary.expectedReturnRatePercent is number
            && data.summary.expectedReturnRatePercent >= 0
          )
        );
    }

    function hasValidPlanShape(data, planId, userId) {
      return data.keys().hasOnly([
          'algorithmVersion',
          'allocations',
          'assumptions',
          'authorUid',
          'budgetYen',
          'candidateSnapshot',
          'createdAt',
          'isSimulation',
          'memo',
          'name',
          'planId',
          'settings',
          'sourcePredictionVersionId',
          'strategy',
          'summary',
          'warnings'
        ])
        && data.planId is string
        && data.planId == planId
        && data.planId.matches('^[A-Za-z0-9_-]{8,120}$')
        && data.authorUid is string
        && data.authorUid == userId
        && data.algorithmVersion == 'phase1-m4-v1'
        && data.isSimulation == true
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 120
        && data.memo is string
        && data.memo.size() <= 2000
        && data.budgetYen is int
        && data.budgetYen >= 0
        && data.budgetYen <= 10000000
        && data.sourcePredictionVersionId is string
        && data.sourcePredictionVersionId.size() >= 1
        && data.sourcePredictionVersionId.size() <= 1500
        && data.strategy in ['expected_value', 'fractional_kelly', 'loss_control']
        && data.allocations is list
        && data.allocations.size() <= 50
        && data.candidateSnapshot is list
        && data.candidateSnapshot.size() == data.allocations.size()
        && data.assumptions is list
        && data.assumptions.size() <= 20
        && data.warnings is list
        && data.warnings.size() <= 100
        && data.createdAt is timestamp
        && data.createdAt == request.time
        && hasValidPlanSettings(data)
        && hasValidPlanSummary(data);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/profile/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/settings/{documentId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/importLog/{importId} {
      allow read, create: if isOwner(userId);
      allow update, delete: if false;
    }

    match /users/{userId}/bankrollTransactions/{transactionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasValidBankrollTransaction(request.resource.data, transactionId, userId);
      allow update, delete: if false;
    }

    match /users/{userId}/races/{raceId} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/races/{raceId}/drafts/{draftId} {
      allow read: if isOwner(userId) && draftId == 'current';
      allow create: if isOwner(userId)
        && draftId == 'current'
        && request.resource.data.revision is int
        && request.resource.data.revision == 1;
      allow update: if isOwner(userId)
        && draftId == 'current'
        && request.resource.data.revision is int
        && resource.data.revision is int
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    match /users/{userId}/races/{raceId}/predictionVersions/{versionId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.status == 'final'
        && request.resource.data.authorUid == userId;
      allow update, delete: if false;
    }

    match /users/{userId}/races/{raceId}/plans/{planId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasValidPlanShape(request.resource.data, planId, userId)
        && isFinalPredictionVersion(userId, raceId, request.resource.data.sourcePredictionVersionId);
      allow update, delete: if false;
    }

    match /users/{userId}/races/{raceId}/purchases/{purchaseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasValidPurchaseShape(request.resource.data, purchaseId, userId, raceId)
        && ((request.resource.data.status == 'draft'
            && request.resource.data.correctionOf == null
            && request.resource.data.correctionSequence == 0
            && request.resource.data.rootPurchaseId == purchaseId)
          || (request.resource.data.status == 'confirmed'
            && request.resource.data.correctionOf == null
            && request.resource.data.correctionSequence == 0
            && request.resource.data.rootPurchaseId == purchaseId
            && activatesNewPurchase(userId, raceId, purchaseId))
          || isValidPurchaseCorrection(userId, raceId, request.resource.data));
      allow update: if isOwner(userId)
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft', 'confirmed']
        && hasValidPurchaseShape(request.resource.data, purchaseId, userId, raceId)
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.rootPurchaseId == resource.data.rootPurchaseId
        && request.resource.data.correctionOf == resource.data.correctionOf
        && request.resource.data.correctionSequence == resource.data.correctionSequence
        && (request.resource.data.status == 'draft'
          || activatesNewPurchase(userId, raceId, purchaseId));
      allow delete: if isOwner(userId) && resource.data.status == 'draft';
    }

    match /users/{userId}/races/{raceId}/results/{resultId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && hasValidResultShape(request.resource.data, resultId, userId, raceId)
        && resultUsesCurrentPurchases(userId, raceId, request.resource.data)
        && ((request.resource.data.status == 'draft'
            && request.resource.data.correctionOf == null
            && request.resource.data.correctionSequence == 0
            && request.resource.data.rootResultId == resultId)
          || (request.resource.data.status == 'confirmed'
            && request.resource.data.correctionOf == null
            && request.resource.data.correctionSequence == 0
            && request.resource.data.rootResultId == resultId
            && (!('latestResultId' in get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)).data)
              || get(/databases/$(database)/documents/users/$(userId)/races/$(raceId)).data.latestResultId == null)
            && getAfter(/databases/$(database)/documents/users/$(userId)/races/$(raceId)).data.latestResultId == resultId)
          || isValidResultCorrection(userId, raceId, request.resource.data));
      allow update: if isOwner(userId)
        && resource.data.status == 'draft'
        && request.resource.data.status in ['draft', 'confirmed']
        && hasValidResultShape(request.resource.data, resultId, userId, raceId)
        && request.resource.data.rootResultId == resource.data.rootResultId
        && request.resource.data.correctionOf == resource.data.correctionOf
        && request.resource.data.correctionSequence == resource.data.correctionSequence;
      allow delete: if isOwner(userId) && resource.data.status == 'draft';
    }

    match /users/{userId}/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
